#!/usr/bin/env python3
"""Lisää nykyisen hakemiston ja annetun URL:n areena-dl-watch-seurantaan."""

import json
import sys
from pathlib import Path

CONFIG_FILE = Path.home() / ".config" / "areena-dl-watch.json"


def main():
    if len(sys.argv) != 2 or not sys.argv[1].startswith("http"):
        print(f"Käyttö: {Path(sys.argv[0]).name} <areena-url>", file=sys.stderr)
        print("Aja siinä hakemistossa johon haluat jaksot latautuvan.", file=sys.stderr)
        sys.exit(1)

    url = sys.argv[1].strip()
    destdir = str(Path.cwd())

    config = []
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE) as f:
            config = json.load(f)

    for entry in config:
        if entry.get("url") == url:
            print(f"Seuranta on jo päällä: {url}")
            print(f"  Kansio: {entry['destdir']}")
            sys.exit(0)

    config.append({"url": url, "destdir": destdir})

    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        json.dump(config, f, indent=2, ensure_ascii=False)
        f.write("\n")

    print(f"Lisätty seurantaan:")
    print(f"  URL:    {url}")
    print(f"  Kansio: {destdir}")
    print(f"  Config: {CONFIG_FILE}")


if __name__ == "__main__":
    main()

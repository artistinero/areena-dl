#!/bin/bash
URL="$1"

FORMATS=$(yt-dlp --list-formats "$URL" 2>/dev/null)
VIDEO_ID=$(echo "$FORMATS" | grep -E 'mp4.*[0-9]+x[0-9]+' | sort -t'x' -k2 -n | tail -1 | awk '{print $1}')
AUDIO_ID=$(echo "$FORMATS" | grep 'audio only' | head -1 | awk '{print $1}')

if [[ -n "$VIDEO_ID" && -n "$AUDIO_ID" ]]; then
    echo "Paras video: $VIDEO_ID, paras ääni: $AUDIO_ID"
    yt-dlp -o "$PWD/%(title)s.%(ext)s" -f "$VIDEO_ID+$AUDIO_ID" --merge-output-format mkv --write-subs --sub-langs all --embed-subs --sub-format "ass/srt/best" --windows-filenames "$URL"
else
    echo "Videoformaatteja ei löydy, kokeillaan yle-dl (äänisisältö)..."
    yle-dl --destdir "$PWD" --restrict-filename-no-specials "$URL"
fi
